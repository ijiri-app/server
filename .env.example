# 이 파일을 .env 로 복사해 값을 채운다. .env 는 커밋하지 않는다.

# --- DB (docker compose 의 db 컨테이너가 이 값으로 만들어진다) ---
POSTGRES_DB=ijiri
DB_USERNAME=ijiri
DB_PASSWORD=
# 로컬에서 bootRun 할 때만 쓴다. docker compose 는 db 컨테이너 주소로 덮어쓴다
DB_URL=jdbc:postgresql://localhost:5432/ijiri

# --- JWT (32바이트 이상 임의 문자열, 예: openssl rand -base64 48) ---
JWT_SECRET=

# --- 메일 (Gmail 은 앱 비밀번호) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- 소셜 로그인 ---
KAKAO_APP_ID=
KAKAO_ADMIN_KEY=
# 웹 클라이언트 ID (필요하면 Android·iOS 클라이언트 ID 도 쉼표로)
GOOGLE_CLIENT_IDS=

# --- 웹 프론트 주소 (쉼표로 여러 개) ---
CORS_ALLOWED_ORIGINS=https://ijiri.net

# --- 사진 저장소: Cloudflare R2 (prod 프로필) ---
STORAGE_PUBLIC_BASE_URL=https://img.ijiri.net
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Cloudflare Tunnel (Zero Trust > Networks > Tunnels 에서 만든 터널의 토큰) ---
CLOUDFLARE_TUNNEL_TOKEN=
