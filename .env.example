# 이 파일을 .env 로 복사해 값을 채운다. .env 는 커밋하지 않는다. compose 의 모든 서비스가 같은 .env 를 읽는다

# --- DB (docker compose 의 db-user, db-community, db-car, db-media 가 이 계정으로 만들어진다) ---
DB_USERNAME=ijiri
DB_PASSWORD=
# 로컬에서 서비스 하나를 bootRun 할 때만 쓴다 (compose 는 서비스별 DB 주소로 덮어쓴다). 모듈별 기본값은 application-local.yaml 에 있다
# DB_URL=jdbc:postgresql://localhost:5432/ijiri_user

# --- JWT (32바이트 이상 임의 문자열, 예: openssl rand -base64 48). service-user 만 쓴다 ---
JWT_SECRET=

# --- 메일 (Gmail 은 앱 비밀번호). MAIL_USERNAME 이 보내는 사람 주소가 된다. service-user 만 쓴다 ---
# 다음 스마트워크(ijiri.net): MAIL_HOST=smtp.daum.net, MAIL_PORT=465, MAIL_SSL=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=

# --- 소셜 로그인 (service-user) ---
KAKAO_APP_ID=
KAKAO_ADMIN_KEY=
# 웹 클라이언트 ID (필요하면 Android·iOS 클라이언트 ID 도 쉼표로)
GOOGLE_CLIENT_IDS=

# --- 웹 프론트 주소 (쉼표로 여러 개). 모든 서비스가 같은 값을 쓴다 ---
CORS_ALLOWED_ORIGINS=https://ijiri.net

# --- 사진 저장소: Cloudflare R2 (service-media, prod 프로필) ---
STORAGE_PUBLIC_BASE_URL=https://img.ijiri.net
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Cloudflare Tunnel (Zero Trust > Networks > Tunnels 에서 만든 터널의 토큰) ---
CLOUDFLARE_TUNNEL_TOKEN=
